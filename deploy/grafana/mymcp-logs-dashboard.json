{
  "title": "mymcp Logs & Traces",
  "uid": "mymcp-logs",
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "mymcp",
    "logs"
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "job",
        "label": "Job",
        "type": "textbox",
        "current": {
          "value": "mymcp",
          "text": "mymcp"
        },
        "query": "mymcp",
        "hide": 0
      },
      {
        "name": "request_id",
        "label": "Request ID",
        "type": "textbox",
        "current": {
          "value": "",
          "text": ""
        },
        "query": "",
        "hide": 0
      },
      {
        "name": "tool",
        "label": "Tool",
        "type": "textbox",
        "current": {
          "value": "",
          "text": ""
        },
        "query": "",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Metrics dashboard",
      "type": "link",
      "url": "/d/mymcp-dashboard",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Log Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Logs (5m)",
      "description": "Count of ERROR-level mymcp logs over the last 5 minutes. Threshold turns red above 10.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=~\"$job\"} | json | levelname=\"ERROR\" [5m]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Distinct Request IDs (5m)",
      "description": "Unique request_id values observed in the last 5 minutes. Useful as a coarse traffic indicator independent of Prometheus.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count(count_over_time({job=~\"$job\"} | json | request_id != \"\" [5m])) by (request_id))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Error Rate",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Error Logs Rate (per level)",
      "description": "Log lines per second by levelname. ERROR/CRITICAL rendered red. Filters: tool=$tool, request_id=$request_id (leave blank for all).",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(ERROR|CRITICAL).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*WARNING.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (levelname) (rate({job=~\"$job\"} | json | levelname=~\"ERROR|CRITICAL|WARNING\" | (\"$tool\" = \"\" or tool=\"$tool\") | (\"$request_id\" = \"\" or request_id=\"$request_id\") [1m]))",
          "legendFormat": "{{levelname}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Recent Logs",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "logs",
      "title": "Recent Errors",
      "description": "Most recent ERROR/CRITICAL log lines. Use the Tool/Request ID variables to filter. Click a trace_id to open it in Tempo.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\"$job\"} | json | levelname=~\"ERROR|CRITICAL\" | (\"$tool\" = \"\" or tool=\"$tool\") | (\"$request_id\" = \"\" or request_id=\"$request_id\")",
          "maxLines": 500
        }
      ]
    },
    {
      "id": 22,
      "type": "logs",
      "title": "All Logs for $request_id",
      "description": "Full log stream for the request_id variable. Leave the variable blank to disable.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\"$job\"} | json | request_id=\"$request_id\" | $request_id != \"\"",
          "maxLines": 1000
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Trace",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "traces",
      "title": "Slowest Traces (5m)",
      "description": "Top slow traces from Tempo. Requires Tempo with metrics-generator or TraceQL search enabled. Click a row to drill into the span tree.",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name=\"mymcp\" } | select(duration) | by(duration) > 100ms"
        }
      ]
    }
  ]
}
