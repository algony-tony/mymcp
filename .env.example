# mymcp configuration template.
# All environment variables use the MYMCP_ prefix.
# Commented values reflect the built-in system defaults; uncomment and modify to override.

# ==============================================================================
# Server & Network
# ==============================================================================

# IP address to bind the HTTP server to. Default: 0.0.0.0 (all interfaces)
# MYMCP_HOST=0.0.0.0

# TCP port to listen on. Default: 8765
# MYMCP_PORT=8765

# Grace period in seconds to wait for in-flight bash commands on SIGTERM before killing. Default: 5
# MYMCP_SHUTDOWN_GRACE_SEC=5

# Public base URL used to construct ticket URLs in prepare_upload/download responses
# when running behind a reverse proxy (e.g., https://mymcp.example.com).
# MYMCP_PUBLIC_BASE_URL=

# ==============================================================================
# TLS & Reverse Proxy
# ==============================================================================

# Path to TLS certificate PEM file for HTTPS termination.
# When configured alongside MYMCP_TLS_KEY, the server serves HTTPS.
# MYMCP_TLS_CERT=

# Path to TLS private key PEM file for HTTPS termination (permissions should be 0600 or 0400).
# MYMCP_TLS_KEY=

# Comma-separated list of trusted upstream proxy CIDRs or IP addresses for client IP extraction.
# Required for honoring X-Forwarded-For or X-Real-IP headers when running behind a reverse proxy.
# Example: 127.0.0.1/32, 10.0.0.0/8, ::1/128
# MYMCP_TRUSTED_PROXIES=

# ==============================================================================
# Authentication & Access Control
# ==============================================================================

# Admin token for managing tokens via the HTTP /admin API.
# If unset at startup, an ephemeral random token is generated and printed to stderr.
# MYMCP_ADMIN_TOKEN=

# Path to the JSON token store file managed by `mymcp token` and `/admin/tokens`.
MYMCP_TOKEN_FILE=/etc/mymcp/tokens.json

# Additional directories or files protected from MCP file tools (comma-separated).
# The audit log directory and server installation directory are always protected.
# Example: /etc/shadow,/root/.ssh
# MYMCP_PROTECTED_PATHS=

# Optional Bearer token required for the Prometheus /metrics endpoint.
# If left empty, /metrics is accessible without authentication.
# MYMCP_METRICS_TOKEN=

# ==============================================================================
# Audit Logging
# ==============================================================================

# Enable structured JSON Lines audit logging of all MCP tool invocations. Default: false
# MYMCP_AUDIT_ENABLED=false

# Directory where audit.log is written (automatically protected from tool access).
MYMCP_AUDIT_LOG_DIR=/var/log/mymcp

# Maximum audit log file size in bytes before rotation occurs. Default: 10485760 (10 MB)
# MYMCP_AUDIT_MAX_BYTES=10485760

# Number of rotated backup files to retain (e.g. audit.log.1, audit.log.2). Default: 5
# MYMCP_AUDIT_BACKUP_COUNT=5

# Maximum head bytes of bash_execute stdout/stderr to retain in audit log. Default: 4096 (4 KB)
# MYMCP_AUDIT_OUTPUT_BASH_HEAD_BYTES=4096

# Maximum tail bytes of bash_execute stdout/stderr to retain in audit log. Default: 4096 (4 KB)
# MYMCP_AUDIT_OUTPUT_BASH_TAIL_BYTES=4096

# ==============================================================================
# Tool Execution Limits & Safety Caps
# ==============================================================================

# bash_execute: Default maximum bytes captured per stdout/stderr stream. Default: 102400 (100 KB)
# MYMCP_BASH_MAX_OUTPUT_BYTES=102400

# bash_execute: Hard maximum bytes allowed for the max_output_bytes parameter. Default: 1048576 (1 MB)
# MYMCP_BASH_MAX_OUTPUT_BYTES_HARD=1048576

# read_file: Default number of lines returned per request. Default: 2000
# MYMCP_READ_FILE_DEFAULT_LIMIT=2000

# read_file: Maximum lines allowed per request. Default: 50000
# MYMCP_READ_FILE_MAX_LIMIT=50000

# read_file: Maximum bytes per line before truncation marker [LINE TRUNCATED]. Default: 32768 (32 KB)
# MYMCP_READ_FILE_MAX_LINE_BYTES=32768

# write_file: Maximum file size in bytes allowed to be written in one call. Default: 10485760 (10 MB)
# MYMCP_WRITE_FILE_MAX_BYTES=10485760

# edit_file: Maximum size of old_string and new_string in bytes. Default: 1048576 (1 MB)
# MYMCP_EDIT_STRING_MAX_BYTES=1048576

# glob: Maximum file paths returned by a glob search. Default: 1000
# MYMCP_GLOB_MAX_RESULTS=1000

# grep: Default maximum match count. Default: 500
# MYMCP_GREP_DEFAULT_MAX_RESULTS=500

# grep: Hard maximum match count. Default: 5000
# MYMCP_GREP_MAX_RESULTS=5000

# ==============================================================================
# Streaming File Transfer (Tickets)
# ==============================================================================

# Enable binary file transfer endpoints (/files/raw/{ticket}). Default: true
# MYMCP_TRANSFER_ENABLED=true

# Default expiration time for transfer tickets in seconds. Default: 300 (5 minutes)
# MYMCP_TRANSFER_DEFAULT_TTL_SEC=300

# Maximum allowed ticket expiration time in seconds. Default: 900 (15 minutes)
# MYMCP_TRANSFER_MAX_TTL_SEC=900

# Maximum file size in bytes for streaming upload/download tickets. Default: 2147483648 (2 GB)
# MYMCP_TRANSFER_MAX_BYTES=2147483648

# ==============================================================================
# Observability (OpenTelemetry)
# ==============================================================================

# OTLP collector endpoint for pushing metrics and traces (optional).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ==============================================================================
# Recorder Sidecar (Optional: pip install "algony-mymcp[recorder]")
# ==============================================================================

# Enable the mymcp-recorder background daemon. Default: false
# MYMCP_RECORDER_ENABLED=false

# Directory where overview.md, changelog.md, and cursor are stored.
# MYMCP_RECORDER_DATA_DIR=/var/lib/mymcp/recorder

# LLM provider for the recorder: anthropic or openai. Default: anthropic
# MYMCP_RECORDER_LLM_PROVIDER=anthropic

# LLM model identifier (leave unset for provider default).
# MYMCP_RECORDER_LLM_MODEL=

# API key for the LLM provider.
# MYMCP_RECORDER_LLM_API_KEY=

# Base URL override (e.g. for DeepSeek or local OpenAI-compatible endpoints).
# MYMCP_RECORDER_LLM_BASE_URL=

# Output token ceiling for recorder LLM calls. Default: 32768
# MYMCP_RECORDER_LLM_MAX_TOKENS=32768

# Seconds between periodic merge cycles. Default: 300 (5 minutes)
# MYMCP_RECORDER_MERGE_INTERVAL_SEC=300

# Maximum mutating audit events processed in a single merge cycle. Default: 50
# MYMCP_RECORDER_MAX_EVENTS_PER_CYCLE=50

# Consecutive merge failures before tripping the circuit breaker (0 disables). Default: 5
# MYMCP_RECORDER_CIRCUIT_BREAKER_THRESHOLD=5

# Maximum probe iterations during initial bootstrap. Default: 200
# MYMCP_RECORDER_BOOTSTRAP_MAX_ITERATIONS=200

# LLM token budget for bootstrap exploration. Default: 10000000
# MYMCP_RECORDER_BOOTSTRAP_TOKEN_BUDGET=10000000

# Per-probe timeout in seconds during bootstrap. Default: 30
# MYMCP_RECORDER_BOOTSTRAP_PROBE_TIMEOUT_SEC=30

# Retry interval in seconds if bootstrap fails. Default: 3600 (1 hour)
# MYMCP_RECORDER_BOOTSTRAP_RETRY_INTERVAL_SEC=3600
