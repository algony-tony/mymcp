# mymcp configuration. All keys use the MYMCP_ prefix (the legacy MCP_ prefix
# was removed in v2.0.0). See README "Configuration" for full descriptions.

# --- Server ---
# Defaults match Settings (0.0.0.0:8765); uncomment + change to override.
# MYMCP_HOST=0.0.0.0
# MYMCP_PORT=8765

# --- Auth ---
# Leave unset to auto-generate a random admin token printed to stderr at startup.
# MYMCP_ADMIN_TOKEN=
MYMCP_TOKEN_FILE=/etc/mymcp/tokens.json

# --- Paths ---
MYMCP_AUDIT_LOG_DIR=/var/log/mymcp
# Extra paths that file tools may not access (audit log dir is always protected).
# MYMCP_PROTECTED_PATHS=/etc/shadow,/root/.ssh

# --- Audit logging ---
# MYMCP_AUDIT_ENABLED=true
# MYMCP_AUDIT_MAX_BYTES=10485760
# MYMCP_AUDIT_BACKUP_COUNT=5
# MYMCP_AUDIT_OUTPUT_BASH_HEAD_BYTES=2048
# MYMCP_AUDIT_OUTPUT_BASH_TAIL_BYTES=2048

# --- Tool limits ---
# MYMCP_BASH_MAX_OUTPUT_BYTES=102400
# MYMCP_BASH_MAX_OUTPUT_BYTES_HARD=1048576
# MYMCP_READ_FILE_DEFAULT_LIMIT=2000
# MYMCP_READ_FILE_MAX_LIMIT=50000
# MYMCP_READ_FILE_MAX_LINE_BYTES=32768
# MYMCP_WRITE_FILE_MAX_BYTES=10485760
# MYMCP_EDIT_STRING_MAX_BYTES=1048576
# MYMCP_GLOB_MAX_RESULTS=1000
# MYMCP_GREP_DEFAULT_MAX_RESULTS=500
# MYMCP_GREP_MAX_RESULTS=5000

# --- Process management ---
# MYMCP_SHUTDOWN_GRACE_SEC=10

# --- File transfer ---
# MYMCP_TRANSFER_ENABLED=true
# MYMCP_TRANSFER_DEFAULT_TTL_SEC=300
# MYMCP_TRANSFER_MAX_TTL_SEC=3600
# MYMCP_TRANSFER_MAX_BYTES=104857600
# Used to build absolute ticket URLs in responses.
# MYMCP_PUBLIC_BASE_URL=https://mymcp.example.com

# --- Observability ---
# If set, /metrics requires Bearer <this>.
# MYMCP_METRICS_TOKEN=
# OpenTelemetry OTLP exporter (optional; install with: pip install algony-mymcp[otlp])
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Recorder (optional; install with: pip install algony-mymcp[recorder]) ---
# MYMCP_RECORDER_ENABLED=false
# MYMCP_RECORDER_DATA_DIR=/var/lib/mymcp/recorder
# MYMCP_RECORDER_LLM_PROVIDER=anthropic
# MYMCP_RECORDER_LLM_MODEL=
# MYMCP_RECORDER_LLM_API_KEY=
# MYMCP_RECORDER_LLM_BASE_URL=
# Per-call output ceiling for the recorder's LLM. Must stay <= the chosen model's max_output_tokens.
# MYMCP_RECORDER_LLM_MAX_TOKENS=16384
# MYMCP_RECORDER_MERGE_INTERVAL_SEC=300
# MYMCP_RECORDER_MAX_EVENTS_PER_CYCLE=200
# Consecutive merge failures before the breaker opens; 0 disables the breaker.
# MYMCP_RECORDER_CIRCUIT_BREAKER_THRESHOLD=5
# MYMCP_RECORDER_BOOTSTRAP_MAX_ITERATIONS=20
# MYMCP_RECORDER_BOOTSTRAP_TOKEN_BUDGET=200000
# MYMCP_RECORDER_BOOTSTRAP_PROBE_TIMEOUT_SEC=30
# MYMCP_RECORDER_BOOTSTRAP_RETRY_INTERVAL_SEC=60
