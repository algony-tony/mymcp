# Live LLM test configuration. Copy to tests/live/.env.live (gitignored) and
# fill in real values. The conftest in this directory auto-loads .env.live
# before any test in tests/live/ runs.
#
# Without these set, all tests marked @pytest.mark.live are skipped.
#
# DeepSeek provides both an OpenAI-compatible endpoint and an Anthropic-
# compatible endpoint, so a single API key covers both adapters.
# Docs: https://api-docs.deepseek.com/zh-cn/

MYMCP_RECORDER_LIVE_TEST_API_KEY=sk-your-deepseek-key-here

# --- Choose ONE provider block (or set both to test both adapters) ---

# OpenAI-compatible (exercises mymcp.recorder.llm.openai_client)
MYMCP_RECORDER_LIVE_TEST_PROVIDER=openai
MYMCP_RECORDER_LIVE_TEST_BASE_URL=https://api.deepseek.com
MYMCP_RECORDER_LIVE_TEST_MODEL=deepseek-chat

# Anthropic-compatible (exercises mymcp.recorder.llm.anthropic_client)
# MYMCP_RECORDER_LIVE_TEST_PROVIDER=anthropic
# MYMCP_RECORDER_LIVE_TEST_BASE_URL=https://api.deepseek.com/anthropic
# MYMCP_RECORDER_LIVE_TEST_MODEL=deepseek-chat
